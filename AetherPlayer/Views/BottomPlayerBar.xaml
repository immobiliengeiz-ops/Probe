<UserControl x:Class="AetherPlayer.Views.BottomPlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelCardStyle}" Padding="16,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{Binding CurrentCoverPath, Converter={StaticResource ImagePathFallbackConverter}}" Width="56" Height="56" Stretch="UniformToFill" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTrackTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentTrackArtist}" Foreground="{StaticResource BrushTextSubtle}" FontSize="12" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="⏮" Width="42" Command="{Binding PreviousCommand}" Margin="0,0,8,0" />
                    <Button Content="▶ / ❚❚" Width="72" Command="{Binding PlayPauseCommand}" Margin="0,0,8,0" />
                    <Button Content="⏭" Width="42" Command="{Binding NextCommand}" Margin="0,0,12,0" />
                    <Button Content="Shuffle" Width="78" Command="{Binding ToggleShuffleCommand}" Margin="0,0,8,0" />
                    <Button Content="Repeat" Width="70" Command="{Binding CycleRepeatModeCommand}" />
                </StackPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentPositionDisplay}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSubtle}" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding CurrentDurationSeconds}" Value="{Binding CurrentPositionSeconds, Mode=TwoWay}" Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding CurrentDurationDisplay}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSubtle}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Queue" Foreground="{StaticResource BrushTextSubtle}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding QueueCount}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <Button Content="Clear" Command="{Binding ClearQueueCommand}" Padding="6,2" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding RepeatModeDisplay}" Foreground="{StaticResource BrushTextSubtle}" />
                    <TextBlock Text="{Binding ShuffleEnabled, StringFormat=Shuffle: {0}}" Foreground="{StaticResource BrushTextSubtle}" />
                </StackPanel>
                <TextBlock Text="Volume" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSubtle}" Margin="0,0,8,0" />
                <Slider Width="120" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
