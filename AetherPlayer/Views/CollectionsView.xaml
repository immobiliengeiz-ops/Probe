<UserControl x:Class="AetherPlayer.Views.CollectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:AetherPlayer.ViewModels">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,14,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Collections" FontSize="24" FontWeight="Bold" />
                <StackPanel Grid.Row="1" Margin="0,12,0,12">
                    <TextBlock Foreground="{StaticResource BrushTextSubtle}" Margin="0,0,0,6" Text="Create or choose a collection, then add selected tracks from Library/Home." />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="170" Text="{Binding NewCollectionName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Create" Margin="8,0,0,0" Command="{Binding CreateCollectionCommand}" />
                    </StackPanel>
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding UserCollections}" SelectedItem="{Binding SelectedCollection}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TrackIds.Count, StringFormat={}{0} tracks}" Foreground="{StaticResource BrushTextSubtle}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Collection Tracks" FontSize="24" FontWeight="Bold" />
                    <Button Content="Add Selected" Margin="14,0,0,0" Command="{Binding AddSelectedToCollectionCommand}" />
                    <Button Content="Remove Selected" Margin="8,0,0,0" Command="{Binding RemoveSelectedFromCollectionCommand}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <ListView x:Name="CollectionTracksList"
                              ItemsSource="{Binding SelectedCollectionTracks}"
                              SelectedItem="{Binding SelectedTrack}"
                              SelectionMode="Extended"
                              SelectionChanged="CollectionTracksList_OnSelectionChanged"
                              MouseDoubleClick="CollectionTracksList_OnMouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:TrackViewModel}">
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding CoverPath, Converter={StaticResource ImagePathFallbackConverter}}" Width="44" Height="44" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" Foreground="{StaticResource BrushTextSubtle}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSubtle}" />
                                    <TextBlock Grid.Column="3" Text="{Binding RatingStars}" VerticalAlignment="Center" Foreground="{StaticResource BrushPrimary}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="No tracks in this collection yet. Select tracks in Library/Home and use Add Selected."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextSubtle}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCollectionTracks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
