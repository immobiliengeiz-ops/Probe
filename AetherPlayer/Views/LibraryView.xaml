<UserControl x:Class="AetherPlayer.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:AetherPlayer.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Library" FontSize="30" FontWeight="Bold" Margin="0,0,0,14" />

        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Tag="GlobalSearchBox" Margin="0,0,10,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1" Margin="0,0,10,0" ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenreFilter}" ToolTip="Main imported folder" Background="{StaticResource BrushSurfaceAlt}" Foreground="{StaticResource BrushText}" />
                <ComboBox Grid.Column="2" Margin="0,0,10,0" ItemsSource="{Binding Moods}" SelectedItem="{Binding SelectedMoodFilter}" ToolTip="Subfolder" Background="{StaticResource BrushSurfaceAlt}" Foreground="{StaticResource BrushText}" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" Background="{StaticResource BrushSurfaceAlt}" Foreground="{StaticResource BrushText}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Padding="0,8,0,0">
            <Grid>
                <ListView x:Name="TracksList" SelectionMode="Extended"
                          ItemsSource="{Binding TracksView}"
                          SelectedItem="{Binding SelectedTrack}"
                          MouseDoubleClick="TracksList_OnMouseDoubleClick"
                              SelectionChanged="TracksList_OnSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewmodels:TrackViewModel}">
                            <Grid Margin="10,8" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Play"
                                                  Command="{Binding PlacementTarget.Tag.ContextPlayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Play Next"
                                                  Command="{Binding PlacementTarget.Tag.ContextPlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Add to Playlist"
                                                  Command="{Binding PlacementTarget.Tag.ContextAddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Add to Collection"
                                                  Command="{Binding PlacementTarget.Tag.ContextAddToCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Toggle Favorite"
                                                  Command="{Binding PlacementTarget.Tag.ContextToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Remove from Library"
                                                  Command="{Binding PlacementTarget.Tag.ContextRemoveFromLibraryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Open File Location"
                                                  Command="{Binding PlacementTarget.Tag.ContextOpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Relink Missing File"
                                                  Command="{Binding PlacementTarget.Tag.RelinkTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding CoverPath, Converter={StaticResource ImagePathFallbackConverter}}" Width="44" Height="44" Stretch="UniformToFill" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artist}" Foreground="{StaticResource BrushTextSubtle}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AvailabilityText}" Foreground="#F29A7D" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Album}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSubtle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding Genre}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSubtle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding MoodTagsDisplay}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSubtle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{Binding DurationDisplay}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSubtle}" />
                                <TextBlock Grid.Column="6" Text="{Binding RatingStars}" VerticalAlignment="Center" Foreground="{StaticResource BrushPrimary}" />
                                <Button Grid.Column="7" Content="♥" FontSize="14" Padding="0" Background="Transparent" Foreground="{Binding IsFavorite, Converter={StaticResource BoolToBrushConverter}}" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Grid.Column="8" Content="+" FontSize="14" Padding="0" ToolTip="Play Next" Background="Transparent" Command="{Binding DataContext.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="No tracks available in this section."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSubtle}"
                           FontSize="18">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNoResultsState}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
