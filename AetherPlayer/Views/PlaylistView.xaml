<UserControl x:Class="AetherPlayer.Views.PlaylistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:AetherPlayer.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Playlists" FontSize="30" FontWeight="Bold" Margin="0,0,0,14" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Your Playlists" FontSize="20" FontWeight="SemiBold" />
                    <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:PlaylistViewModel}">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="44" Height="44" Source="{Binding CoverPath, Converter={StaticResource ImagePathFallbackConverter}}" Stretch="UniformToFill" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TrackCount, StringFormat={}{0} tracks}" FontSize="12" Foreground="{StaticResource BrushTextSubtle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tracks in Playlist" FontSize="20" FontWeight="SemiBold" />
                        <Button Content="Add Selected" Margin="12,0,0,0" Command="{Binding AddSelectedToPlaylistCommand}" />
                        <Button Content="Remove Selected" Margin="8,0,0,0" Command="{Binding RemoveSelectedFromPlaylistCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Foreground="{StaticResource BrushTextSubtle}" Margin="0,0,0,8" Text="Right-click tracks in Library/Home and choose &quot;Add to Playlist&quot;, or select tracks and use Add Selected."/>
                        <ListView x:Name="PlaylistTracksList" Margin="0,0,0,0" ItemsSource="{Binding SelectedPlaylistTracks}" SelectedItem="{Binding SelectedTrack}" SelectionMode="Extended"
                              SelectionChanged="PlaylistTracksList_OnSelectionChanged" MouseDoubleClick="PlaylistTracksList_OnMouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:TrackViewModel}">
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="44" Height="44" Source="{Binding CoverPath, Converter={StaticResource ImagePathFallbackConverter}}" Stretch="UniformToFill" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{StaticResource BrushTextSubtle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Album}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSubtle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Genre}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSubtle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding DurationDisplay}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSubtle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
