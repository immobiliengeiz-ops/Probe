<UserControl x:Class="AetherPlayer.Views.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AetherPlayer.Converters">
    <UserControl.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatchConverter" />
    </UserControl.Resources>

    <Border Style="{StaticResource PanelCardStyle}" Padding="16,20">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Aether Player" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Premium Desktop Listening" Margin="0,4,0,22" Foreground="{StaticResource BrushTextSubtle}" />

                <Button Style="{StaticResource NavButtonStyle}" Content="Home" Command="{Binding NavigateCommand}" CommandParameter="Home" />
                <Button Style="{StaticResource NavButtonStyle}" Content="Library" Command="{Binding NavigateCommand}" CommandParameter="Library" />
                <Button Style="{StaticResource NavButtonStyle}" Content="Playlists" Command="{Binding NavigateCommand}" CommandParameter="Playlists" />
                <Button Style="{StaticResource NavButtonStyle}" Content="Favorites" Command="{Binding NavigateCommand}" CommandParameter="Favorites" />
                <Button Style="{StaticResource NavButtonStyle}" Content="Recently Added" Command="{Binding NavigateCommand}" CommandParameter="RecentlyAdded" />
                <Button Style="{StaticResource NavButtonStyle}" Content="Recently Played" Command="{Binding NavigateCommand}" CommandParameter="RecentlyPlayed" />
                <Button Style="{StaticResource NavButtonStyle}" Content="Collections" Command="{Binding NavigateCommand}" CommandParameter="Collections" />
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Background="#1F2536" CornerRadius="14" Padding="12" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Now Curating" FontWeight="SemiBold" />
                    <TextBlock Text="Your local tracks stay private and native to Windows." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource BrushTextSubtle}" FontSize="12" />
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
